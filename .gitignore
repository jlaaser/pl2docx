.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
dist/
build/

# real config with local server/course/assessment IDs - keep config.example.yaml checked in instead
config.yaml

# runtime output: fetched HTML + generated docx files
output/

# generated instructor template (run `pl2docx-starter-template` to create your own,
# real-world-usage default location per config.example.yaml's template_path)
template.docx

# session-by-session development planning/handoff notes - useful for the author's own
# reference but not needed by users of the published tool; see notes/ for the
# public-facing architecture/configuration/templating docs instead
planning_notes/

# local-only project instructions (course-specific paths, personal setup notes) -
# see CLAUDE.md for the public-facing project instructions
CLAUDE.local.md
